    "availability": "unconditional",
    "documentation": "docs/architecture.md#graph-schema",
    "edge_relations": 38,
    "functions": [
      "graph.credit_role_category",
      "graph.mb_relationship_type",
      "graph.medium_label"
    ],
    "introduced_in_contract_version": 1,
    "key_columns": {
      "availability": "unconditional",
      "kind": "additive",
      "note": "Every key column of every graph relation is text. PostgreSQL 19 beta 3 cannot resolve an equality operator for a character varying property-graph vertex key, so the four Discogs vertex views publish data_id::text and the loader-written tables are declared text from the start. This retires the graph.artist.artist_key, graph.label.label_key, graph.master.master_key, and graph.release.release_key restatements the phase 0 views appended for the same reason; nothing but CREATE PROPERTY GRAPH ever read them and they were never declared as properties.",
      "type": "text"
    },
    "kind": "additive",
    "note": "Twenty relations are loader-written tables and the rest are read-only views over tables declared elsewhere in this contract. Seven further tables hold the counters, degrees, and genre aggregates the graph enrichers compute today. This repository declares every one of them and writes rows into none: the owner named against each relation does that, so an empty table on a fresh database is the expected state rather than a fault.",
    "property_graph": {
      "absent_on": "PostgreSQL 18, and PostgreSQL 19 with the switch off",
      "availability": "conditional",
      "conditions": [
        "server_version_num >= 190000",
        "the SCHEMA_PROPERTY_GRAPH environment switch is enabled"
      ],
      "consumer_rule": "consumers must not assume it exists; probe pg_class for a relation named catalog in schema graph, of relkind g, and fall back to the views, which are always present",
      "documentation": "docs/architecture.md#property-graph",
      "edge_tables": 38,
      "kind": "additive",
      "name": "graph.catalog",
      "note": "A SQL/PGQ declaration over the graph schema's tables and views, applied after the rest of the PostgreSQL schema. A closed gate is logged and is not a failure. There is no IF NOT EXISTS for a property graph and this initializer never drops one except through a shape migration that re-declares it on the same run, so an existing graph.catalog is otherwise left as it is and a changed declaration does not roll out on its own.",
      "vertex_tables": 21
    },
